# JobLens 后端环境变量示例
# 复制为 .env 后按需修改。所有变量使用 JOBLENS_ 前缀。

# 应用
JOBLENS_APP_NAME=JobLens API
JOBLENS_DEBUG=false

# 数据库（默认 backend/data/joblens.db）
# JOBLENS_DATABASE_URL=sqlite:///./data/joblens.db

# 允许跨域的前端地址，必须是 JSON 数组
JOBLENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 单个 JSON 导入文件大小上限（字节），默认 10MB
JOBLENS_MAX_UPLOAD_BYTES=10485760
